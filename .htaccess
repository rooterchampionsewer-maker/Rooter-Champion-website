# Rooter Champion — URL cleanup & 301 redirects
# Goal: one canonical URL per page -> https://rooterchampion.net/<page>.html

RewriteEngine On

# 1) Force HTTPS and non-www in a single hop
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^(.*)$ https://rooterchampion.net/$1 [R=301,L]

# 2) Old-site pages that no longer exist -> closest current page
#    (trailing slash optional, case-insensitive)
# Old city URLs that now have their own page
RewriteRule ^(whittier|la-mirada|norwalk|hacienda-heights|rowland-heights)/?$ /$1.html [R=301,L,NC]
# Old city URLs with no page of their own -> Service Areas
RewriteRule ^(tustin|west-covina|santa-ana|orange|orange-county)/?$ /service-areas.html [R=301,L,NC]
RewriteRule ^hydro-jetting/?$ /hydro-jetting.html [R=301,L,NC]
RewriteRule ^descaling(\.html)?/?$ /sewer-robotics.html [R=301,L,NC]

# 3) Extensionless URL (with or without trailing slash) -> .html when that page exists
#    /anaheim  or  /anaheim/  -> /anaheim.html
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{DOCUMENT_ROOT}/$1.html -f
RewriteRule ^([^./]+)/?$ /$1.html [R=301,L]

# 4) Any other trailing slash on a non-directory -> strip it
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.+)/$ /$1 [R=301,L]
